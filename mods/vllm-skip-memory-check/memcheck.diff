+def test_request_memory_bypasses_strict_memory_check():
+    """VLLM_STRICT_MEMORY_CHECK=0 must downgrade the gpu_memory_utilization
+    startup check to a warning instead of raising."""
+    cache_config = CacheConfig(gpu_memory_utilization=0.9)
+    snapshot = MemorySnapshot(
+        free_memory=80,
+        total_memory=100,
+        device=None,
+        auto_measure=False,
+    )
+    # free (80) < requested (ceil(0.9 * 100) = 90).
+    with pytest.raises(ValueError, match="less than desired"):
+        request_memory(snapshot, cache_config)
+
+    with patch("vllm.v1.worker.utils.envs.VLLM_STRICT_MEMORY_CHECK", False):
+        requested = request_memory(snapshot, cache_config)
+    assert requested == 90
+
+
+def test_check_enough_kv_cache_memory_bypasses_strict_memory_check():
+    """VLLM_STRICT_MEMORY_CHECK=0 must downgrade the KV cache admission check
+    to a warning instead of raising when the pre-allocated buffer is too
+    small."""
+    model_config = ModelConfig(max_model_len=16384)
+    vllm_config = VllmConfig(model_config=model_config)
+    mem_per_block_per_layer = 16 * 2 * 64 * 4 * 2
+    kv_cache_spec = {
+        "layer_1": new_kv_cache_spec(),
+        "layer_2": new_kv_cache_spec(),
+    }
+    # Only 8 blocks available, far fewer than max_model_len=16384 needs.
+    small_available = mem_per_block_per_layer * 2 * 8
+
+    with pytest.raises(ValueError, match="max seq len"):
+        check_enough_kv_cache_memory(vllm_config, kv_cache_spec, small_available)
+
+    with patch("vllm.v1.core.kv_cache_utils.envs.VLLM_STRICT_MEMORY_CHECK", False):
+        check_enough_kv_cache_memory(vllm_config, kv_cache_spec, small_available)
