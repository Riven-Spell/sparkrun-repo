+    new_odd = torch.addcmul(odd * cos, even, sin)
+    rope_rotated = torch.stack((new_even, new_odd), dim=-1).reshape(shape)
+
+    out = x.clone()
+    out[..., nope_dim:] = rope_rotated.to(out.dtype)
+    return out
