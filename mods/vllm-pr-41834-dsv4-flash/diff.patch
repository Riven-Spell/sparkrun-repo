-    if hasattr(envs.__getattr__, "cache_clear"):
-        envs.__getattr__.cache_clear()
-
-    assert envs.VLLM_DEEPSEEK_V4_SPARSE_MLA_STATS_PATH is None
-
-    monkeypatch.setenv(
-        "VLLM_DEEPSEEK_V4_SPARSE_MLA_STATS_PATH",
-        "/tmp/sparse_mla_stats",
