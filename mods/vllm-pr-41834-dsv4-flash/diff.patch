+
+    assert calls == [(layer, (1, 1, 2, 512), (1, 1, 512), metadata, (1, 2, 512))]
+
+
+def test_compressed_decode_uses_triton_path_without_flashmla_tile_sched(monkeypatch):
+    layer = _make_layer(compress_ratio=128)
