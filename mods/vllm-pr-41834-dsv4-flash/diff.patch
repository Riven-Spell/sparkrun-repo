+
+
+def test_compact_address_overlapping_spans_raises() -> None:
+    spans = (CompactCPUAddressSpan(100, 100, 150), CompactCPUAddressSpan(200, 100, 100))
+    with pytest.raises(ValueError, match="must not overlap"):
