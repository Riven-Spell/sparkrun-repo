+"""Focused unit tests for compact CPU KV accounting (lean commit 1).
+
+Excludes dead fields, DeepSeek-specific prefer_early_eviction, and
+bounded-tail policy.
+"""
+
+import pytest
+import torch
+
+from vllm.v1.kv_cache_interface import (
+    FullAttentionSpec,
+    KVCacheConfig,
+    KVCacheGroupSpec,
