           // Trivial case: seq_len <= TopK
@@ -919,8 +1033,14 @@ __global__ void __launch_bounds__(kThreadsPerBlock, 2)
           }
         } else if (seq_len <= static_cast<uint32_t>(HIST2048_THRESHOLD)) {
